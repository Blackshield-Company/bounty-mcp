{
  "name": "bounty-mcp",
  "version": "0.1.0",
  "description": "MCP server (stdio) with tools for searching paid open-source bounties on GitHub and Opire",
  "type": "module",
  "license": "MIT",
  "author": "synthalorian",
  "private": false,
  "bin": {
    "bounty-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bounty",
    "github",
    "opire",
    "algora"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blackshield-Company/bounty-mcp.git"
  },
  "homepage": "https://github.com/Blackshield-Company/bounty-mcp#readme",
  "bugs": {
    "url": "https://github.com/Blackshield-Company/bounty-mcp/issues"
  }
}
